<Window x:Class="Rhythm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rhythm"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        MinHeight="80"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown"
        Title="Rhythm">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            CornerRadius="10"
            Padding="14"
            Focusable="True"
            MouseLeftButtonDown="OnBorderMouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="编辑事项..." Click="OnEditClick"/>
                <MenuItem Header="隐藏窗口" Click="OnHideClick"/>
                <Separator/>
                <MenuItem Header="退出 Rhythm" Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding CurrentDate}" Style="{StaticResource HeaderDateStyle}"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HeaderStatsStyle}"/>
            </StackPanel>

            <!-- Items Section with ScrollViewer -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="600"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCardStyle}">
                                    <CheckBox Style="{StaticResource ItemCheckBoxStyle}"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}">
                                        <CheckBox.Content>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource ItemTextStyle}"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource EmptyHintStyle}"
                               Text="今天没有事项"
                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
