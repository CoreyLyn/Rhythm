<Window
    x:Class="Rhythm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Rhythm"
    Title="Rhythm"
    Width="320"
    MinHeight="80"
    AllowsTransparency="True"
    Background="Transparent"
    KeyDown="OnWindowKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Border
        Padding="14"
        Background="{StaticResource WindowBackgroundBrush}"
        CornerRadius="10"
        Focusable="True"
        MouseLeftButtonDown="OnBorderMouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Click="OnEditClick" Header="编辑事项..." />
                <MenuItem Click="OnHideClick" Header="隐藏窗口" />
                <Separator />
                <MenuItem Click="OnExitClick" Header="退出 Rhythm" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header Section  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource HeaderDateStyle}" Text="{Binding CurrentDate}" />
                <TextBlock Style="{StaticResource HeaderStatsStyle}" Text="{Binding ProgressText}" />
            </StackPanel>

            <!--  Items Section with ScrollViewer  -->
            <ScrollViewer
                Grid.Row="1"
                MaxHeight="600"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCardStyle}">
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource ItemCheckBoxStyle}">
                                        <CheckBox.Content>
                                            <TextBlock Style="{StaticResource ItemTextStyle}" Text="{Binding Text}" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Style="{StaticResource EmptyHintStyle}"
                        Text="今天没有事项"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
